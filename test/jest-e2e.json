{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/e2e/setup-env.ts"],
  "moduleNameMapper": {
    "^@smth/shared$": "<rootDir>/e2e/mocks/smth-shared.js"
  },
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
